  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "echo 'Starting server' && npx cypress run --record --key 84634ed5-d0da-426e-ac00-39796ed9ad22",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "build": "npm run cy:run",
    "test:chrome": "npx cypress run --browser chrome --headed",
    "test:firefox": "npx cypress run --browser firefox",
    "test:edge": "npx cypress run --browser edge",
  
    "ci:parallel": "cypress-parallel",
    "ci:chrome": "npm run ci:parallel -- -s 'ci:run --browser chrome --record'",
    "ci:firefox": "npm run ci:parallel -- -s 'ci:run --browser firefox --record'",
    "ci:edge": "npm run ci:parallel -- -s 'ci:run --browser edge --record'"
  },
