    "cypress": "^13.6.2",
    "cypress-mochawesome-reporter": "^3.7.0",
    "cypress-parallel": "^0.14.0",
    "cypress-xpath": "^2.0.1",
    "faker": "^5.5.3",
    "npm-run-all": "^4.1.5"
  },
